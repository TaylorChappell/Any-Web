{
  "name": "any-desktop",
  "productName": "ANY",
  "version": "0.3.0",
  "description": "ANY for Windows with native video controls and Together",
  "author": "Taylor Chappell",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:electron": "electron . --self-test",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fun.anymovies.desktop",
    "productName": "ANY",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "test/electron-smoke.cjs",
      "test/fixture.webm",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ANY-Setup-${version}.${ext}",
      "runAfterFinish": false
    }
  }
}
